{
  "id": "8a2ff670-b904-4a2e-b70b-024ddf050cc8",
  "name": "jev_bench stop_gate case format",
  "kind": "type",
  "consumers": [
    "examples/jev_bench/main.rs",
    "examples/jev_bench/cases/stop_gate.json",
    "examples/jev_bench/README.md"
  ],
  "current": {
    "version": 1,
    "shape": {
      "Case": {
        "difficulty": "easy|medium|hard",
        "expect": {
          "deterministic_human": "bool (true implies needs_human)",
          "route": "continue_same_task|continue_next_task|needs_lead|needs_human|allow_stop"
        },
        "id": "string, unique (stop-NNN)",
        "source": "string: 'jev_e2e <run> <worker>, transcript message N' | 'session <id8>, <time>' (real) | 'synthetic' | 'derived from jev_e2e ...' (synthetic)",
        "stop": {
          "agent": "string",
          "board": {
            "note": "string",
            "open_unblocked_tasks": "bool"
          },
          "final_message": "string, <= 1200 chars",
          "last_tools": {
            "files_changed": "string[]",
            "outcomes": "string[] (non-empty)",
            "tests": "string|null"
          },
          "task": {
            "acceptance_criteria": "string[] (non-empty)",
            "status": "todo|in_progress|blocked|done",
            "title": "string"
          }
        },
        "synthetic": "bool",
        "uncertain": "optional string",
        "why": "string"
      },
      "file": "examples/jev_bench/cases/stop_gate.json",
      "invariants": [
        "no seed/action: a stop is not an MCP call",
        "continue_next_task implies board.open_unblocked_tasks",
        "done report with own tests/check.sh failing => continue_same_task, not allow_stop"
      ],
      "top": {
        "cases": "Case[]",
        "site": "stop_gate"
      }
    },
    "notes": "75 cases (51 real, 24 synthetic incl. 7 derived). allow_stop added as 5th route, approved by jev-lead. Labels blind to Jev. Harness does not run the site yet. Validator kept outside the repo in the stop-labeler scratchpad.",
    "published_by": "stop-labeler",
    "published_at": "2026-09-17T04:48:48.198062Z"
  },
  "history": []
}
