# Rust
/target/
**/*.rs.bk

# Tirith runtime state (leases, task board, daemon info). Contracts, notices,
# decisions and memory under .tirith/ are meant to be committed.
/.tirith/runtime/

# graphify knowledge graph: built per machine with `graphify update .`
/graphify-out/

# Editors / OS
.DS_Store
.idea/
.vscode/
# keep .cursor/mcp.json committed; it is project config
*.swp

# Serena local overrides and caches
/.serena/cache/
/.serena/project.local.yml

# Claude Code: only the skills link and settings.json are versioned
.claude/*
!.claude/skills
!.claude/settings.json

# Local secrets. Never commit.
.env
.env.*
