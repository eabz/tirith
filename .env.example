# Copy to .env and fill in. .env is gitignored.
# Keys for the experimental Jev integration (`tirith serve --jev`, ADR-0024).
# TypeSafe direct is used when its key is set; otherwise the Vercel AI Gateway.
TYPESAFE_API_KEY=
AI_GATEWAY_API_KEY=
# Optional: force one provider when both keys are set (typesafe | gateway).
# TIRITH_JEV_PROVIDER=
# TIRITH_JEV_MODEL=
# TIRITH_JEV_TIMEOUT_MS=5000
